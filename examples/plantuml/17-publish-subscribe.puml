@startuml
title Publish-Subscribe Processing
left to right direction

component "Event Producer" as node_1
queue "Domain Events" as node_2
component "Analytics Consumer" as node_3
component "Billing Consumer" as node_4
component "Notification Consumer" as node_5
database "Analytics Store" as node_6
rectangle "Audit Log" as node_7

node_1 --> node_2 : Publish event
node_2 --> node_3 : Analytics subscription
node_2 --> node_4 : Billing subscription
node_2 --> node_5 : Notification subscription
node_3 --> node_6 : Aggregate
node_4 --> node_7 : Record charge
node_5 --> node_7 : Record delivery
@enduml
