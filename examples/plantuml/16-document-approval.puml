@startuml
title Document Approval Workflow

actor "Author" as node_1
component "Document Intake" as node_2
actor "Reviewer" as node_3
queue "Approval Queue" as node_4
database "Document Archive" as node_5
component "Notification Service" as node_6

node_1 --> node_2 : Submit draft
node_2 --> node_4 : Queue review
node_4 --> node_3 : Assign review
node_3 --> node_5 : Approve
node_3 --> node_1 : Request changes
node_5 --> node_6 : Published
node_6 --> node_1 : Send status
@enduml
